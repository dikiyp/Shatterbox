// Screenshot-free version of carbine_hold for frame-time statistics:
// PNG readback stalls a few frames hard enough to poison p99/1% low.
Scenario(
    name: "carbine_perf",
    scene: Some("house"),
    steps: [
        Camera(pos: (123.5, 3.0, 139.0), yaw: 0.0, pitch: 0.0),
        Wait(frames: 60),
        Select(slot: 2),
        // 3 s of held trigger, then let the rubble settle.
        Hold(weapon: carbine, frames: 180),
        Wait(frames: 300),
        Assert(check: voxel_conservation, tolerance: None),
        Exit,
    ],
)
