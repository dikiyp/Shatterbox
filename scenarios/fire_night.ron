// fx_lab / part 1: the same wooden crate inside the closed room, but at night
// with the ceiling lamp off (time 22:00 is below the sun, the lamp is still a
// point light in the rig). Fire has to light the walls and the white floor
// orange through the DDGI bounce.
//
// Effects: 1 shadows, 2 ssao, 16 taa, 32 fog, 64 ssr, 2048 ddgi, 8192 smoke.
Scenario(
    name: "fire_night",
    scene: Some("fx_lab"),
    steps: [
        Effects(bits: 10355),
        TimeOfDay(hours: 22.0),
        Camera(pos: (107.8, 1.7, 106.4), yaw: -1.00, pitch: -0.05),
        Wait(frames: 90),
        Screenshot(name: "night_before"),
        Assert(check: no_floating, tolerance: None),
        Select(slot: 3),
        Hold(weapon: flame, frames: 30),
        Screenshot(name: "night_0_5s"),
        Hold(weapon: flame, frames: 30),
        Screenshot(name: "night_1s"),
        Wait(frames: 60),
        Screenshot(name: "night_2s"),
        Wait(frames: 120),
        Screenshot(name: "night_4s"),
        Wait(frames: 240),
        Screenshot(name: "night_8s"),
        Wait(frames: 420),
        Screenshot(name: "night_15s"),
        // Fire deletes charred voxels without adding them to the dust counter;
        // part 4 owns that accounting, so only the structural assert runs here.
        Exit,
    ],
)
