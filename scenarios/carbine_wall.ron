// Carbine check: ten quick rounds into the brick wall. The crater must stay
// small (a capsule of 2 voxels) and the tracer must end at the crosshair.
Scenario(
    name: "carbine_wall",
    scene: Some("house"),
    steps: [
        Camera(pos: (123.5, 3.0, 139.0), yaw: 0.0, pitch: 0.0),
        Wait(frames: 20),
        Screenshot(name: "carbine_before"),
        Assert(check: hit_matches_render, tolerance: Some(1.0)),
        Select(slot: 2),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 7),
        Fire(weapon: carbine),
        Wait(frames: 40),
        Screenshot(name: "carbine_after"),
        Assert(check: voxel_conservation, tolerance: None),
        Exit,
    ],
)
