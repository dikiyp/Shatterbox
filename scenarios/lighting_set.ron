// Lighting diagnosis: three conditions (bright day, low sun, night with lamps)
// from the same interior camera. Each condition captures the shipping look and
// then disables exactly one stage, so the toxic-colour / flat-image culprit can
// be named from the PNGs instead of guessed.
//
// Post debug bits (see post.wgsl):
//   1 no saturation+grade, 2 no black lift, 4 no pre-tonemap gain,
//   8 no ACES, 16 no bloom, 32 no vignette, 64 full hemisphere ambient.
//   2 used to disable the old post-tonemap S-curve; that stage is gone.
// Effects 123 = shadows + SSAO + VCT/GI + TAA + fog + SSR (the default rig).
Scenario(
    name: "lighting_set",
    scene: Some("house"),
    steps: [
        Camera(pos: (126.0, 3.0, 131.0), yaw: 3.14159, pitch: 0.0),

        // ---- bright day -------------------------------------------------
        TimeOfDay(hours: 12.0),
        Effects(bits: 123),
        Post(debug: 0, look: 0),
        Wait(frames: 30),
        Screenshot(name: "day_base"),
        Post(debug: 1),
        Wait(frames: 12),
        Screenshot(name: "day_no_grade"),
        Post(debug: 2),
        Wait(frames: 12),
        Screenshot(name: "day_no_lift"),
        Post(debug: 4),
        Wait(frames: 12),
        Screenshot(name: "day_no_gain"),
        Post(debug: 8),
        Wait(frames: 12),
        Screenshot(name: "day_no_aces"),
        Post(debug: 16),
        Wait(frames: 12),
        Screenshot(name: "day_no_bloom"),
        Post(debug: 64),
        Wait(frames: 12),
        Screenshot(name: "day_full_ambient"),
        Post(debug: 0),
        Effects(bits: 91),
        Wait(frames: 12),
        Screenshot(name: "day_no_fog"),
        Effects(bits: 115),
        Wait(frames: 12),
        Screenshot(name: "day_no_vct"),
        Effects(bits: 123),

        // ---- low sun ----------------------------------------------------
        TimeOfDay(hours: 17.2),
        Post(debug: 0, look: 0),
        Wait(frames: 30),
        Screenshot(name: "low_base"),
        Post(debug: 1),
        Wait(frames: 12),
        Screenshot(name: "low_no_grade"),
        Post(debug: 2),
        Wait(frames: 12),
        Screenshot(name: "low_no_lift"),
        Post(debug: 4),
        Wait(frames: 12),
        Screenshot(name: "low_no_gain"),
        Post(debug: 8),
        Wait(frames: 12),
        Screenshot(name: "low_no_aces"),
        Post(debug: 16),
        Wait(frames: 12),
        Screenshot(name: "low_no_bloom"),
        Post(debug: 64),
        Wait(frames: 12),
        Screenshot(name: "low_full_ambient"),
        Post(debug: 0),
        Effects(bits: 91),
        Wait(frames: 12),
        Screenshot(name: "low_no_fog"),
        Effects(bits: 115),
        Wait(frames: 12),
        Screenshot(name: "low_no_vct"),
        Effects(bits: 123),

        // ---- night with lamps -------------------------------------------
        TimeOfDay(hours: 22.0),
        Post(debug: 0, look: 0),
        Wait(frames: 30),
        Screenshot(name: "night_base"),
        Post(debug: 1),
        Wait(frames: 12),
        Screenshot(name: "night_no_grade"),
        Post(debug: 2),
        Wait(frames: 12),
        Screenshot(name: "night_no_lift"),
        Post(debug: 4),
        Wait(frames: 12),
        Screenshot(name: "night_no_gain"),
        Post(debug: 8),
        Wait(frames: 12),
        Screenshot(name: "night_no_aces"),
        Post(debug: 16),
        Wait(frames: 12),
        Screenshot(name: "night_no_bloom"),
        Post(debug: 64),
        Wait(frames: 12),
        Screenshot(name: "night_full_ambient"),
        Post(debug: 0),
        Effects(bits: 91),
        Wait(frames: 12),
        Screenshot(name: "night_no_fog"),
        Effects(bits: 115),
        Wait(frames: 12),
        Screenshot(name: "night_no_vct"),
        Effects(bits: 123),

        Assert(check: voxel_conservation, tolerance: None),
        Exit,
    ],
)
