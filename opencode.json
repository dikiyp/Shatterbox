
{
    "$schema": "https://opencode.ai/config.json",
    "model": "dolphin/deepseek-ai/DeepSeek-V4.1-Flash",
    "compaction": {
        "auto": false
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "C:/Users/dikiy/ponytail/.opencode/plugins/ponytail.mjs"
    ],
    "provider": {
        "dolphin": {
            "name": "Dolphin",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://lighthouse.dphn.ai/run/text-v/v1"
            },
            "models": {
                "deepseek-ai/DeepSeek-V4.1-Flash": {
                    "name": "DeepSeek V4.1 Flash",
                    "cost": {
                        "input": 0.04,
                        "output": 0.50
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 32768
                    }
                }
            }
        },
        "corti": {
            "name": "Corti",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://ai.eu.corti.app/v1",
                "apiKey": "{env:CORTI_BEARER}"
            },
            "models": {
                "corti-s1": {
                    "name": "Corti S1",
                    "cost": {
                        "input": 2,
                        "output": 8
                    }
                }
            }
        }
    }
}
